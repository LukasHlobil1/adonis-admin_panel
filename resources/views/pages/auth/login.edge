@layouts.auth()
  <h1 class="auth__title">Vítejte zpět</h1>
  <p class="auth__sub">Přihlaste se do správy uživatelů.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Heslo' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Přihlásit se',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Okamžik…' : 'Přihlásit se'",
    })
  @end

  <p class="auth__foot">
    

    Ještě nemáte účet?


    @link({ route: 'new_account.create', class: 'il' })
      Zaregistrujte se
    @end
  </p>
@end
