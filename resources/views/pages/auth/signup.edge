@layouts.auth()
  <h1 class="auth__title">Vytvořit účet</h1>
  <p class="auth__sub">Zaregistrujte se do správy uživatelů.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Celé jméno' })
      @!input.control({ autocomplete: 'name', placeholder: 'Jan Novák' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Heslo' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Potvrzení hesla' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Vytvořit účet',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Okamžik…' : 'Vytvořit účet'",
    })
  @end

  <p class="auth__foot">
    
    Už máte účet?

    @link({ route: 'session.create', class: 'il' })
      Přihlaste se
    @end
  </p>
@end
