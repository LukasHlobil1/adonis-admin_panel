{{--
  Top-level app navigation. Add an entry here for every new area of your
  app, and it shows up in the navigation bar with its active state handled.
--}}
@let(nav = [
  { label: 'Přehled', route: 'dashboard', icon: 'lucide:house' },
  { label: 'Můj profil', route: 'profile.edit', icon: 'lucide:user-round' },
])
@if(auth.user && auth.user.isAdmin)
  @assign(nav = [...nav, { label: 'Uživatelé', route: 'admin.users.index', icon: 'lucide:users' }])
@end
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="cs"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} – Správa uživatelů` : 'Správa uživatelů – AdonisJS' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--bar">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @if(auth.user)
            <span class="header__user">
              <span class="avatar avatar--sm">{{ auth.user.initials }}</span>
              <span class="header__user-name">{{ auth.user.displayName }}</span>
              @if(auth.user.isAdmin)
                <span class="badge badge--admin">Admin</span>
              @end
            </span>
          @end
          @!themeToggle()
          @form({ route: 'session.destroy', method: 'POST' })
            <button type="submit" class="btn btn--secondary btn--sm">
              @svg('lucide:log-out', { width: 15, height: 15 })
              Odhlásit
            </button>
          @end
        </div>
      </div>
    </header>

    <nav class="subnav">
      <div class="subnav__inner">
        @each(item in nav)
          @navLink({ route: item.route, class: 'subnav__item' })
            @if(item.icon)
              @svg(item.icon, { width: 14, height: 14 })
            @end
            {{ item.label }}
          @end
        @end
      </div>
    </nav>

    <div class="app-main">{{{ await $slots.main() }}}</div>
    @include('partials/flash_alerts')
  </body>
</html>
